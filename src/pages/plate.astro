---
import Layout from '../layouts/Layout.astro';
import { getPlateIndex } from '../data/captions';

// Registration search reads from captions.ts directly (not a photo glob) since
// it only needs the small set of entries that actually have a plate — no need
// to touch every image file for this. New captions get a plate when visible
// (see scripts/caption-batch.mjs); nothing has been backfilled for photos
// captioned before this existed.
const plates = getPlateIndex();
---

<Layout
  title="Search by Registration — TrackMarc Motorsport Photography"
  description="Find your car on TrackMarc by its registration plate."
>
  <div style="padding-top: var(--nav-height);">
    <div class="section">
      <div class="section-header">
        <p class="section-eyebrow">Find Your Car</p>
        <h1 class="section-title">Search by Registration</h1>
        <p class="section-subtitle">
          Spot your own car at an event? Type its plate to find every photo of it.
        </p>
      </div>

      <div class="plate-search">
        <input
          type="text"
          id="plate-input"
          placeholder="e.g. 141-D-12345"
          autocomplete="off"
          spellcheck="false"
        />
      </div>

      <p class="plate-status" id="plate-status">
        {plates.length === 0
          ? "No plates recorded yet — this is a new feature, only photos captioned from here on will show up."
          : `${plates.length} photograph${plates.length !== 1 ? 's' : ''} have a plate on record.`}
      </p>

      <div class="plate-results" id="plate-results"></div>
    </div>
  </div>

  <script define:vars={{ plates }}>
    const input = document.getElementById('plate-input');
    const results = document.getElementById('plate-results');
    const status = document.getElementById('plate-status');
    const defaultStatus = status.textContent;

    function normalise(s) {
      return s.toLowerCase().replace(/[\s-]+/g, '');
    }

    // Gemini reads plates from photos and can misread a single character —
    // the classic OCR confusions (O/0, I/L/1, S/5, B/8, Z/2, G/6). If a
    // visitor's exact plate finds nothing, retry with these folded together
    // before giving up, so one bad character doesn't hide a real match.
    // Deliberately narrow (not general fuzzy/edit-distance matching) so it
    // can't start surfacing someone else's car for an unrelated plate.
    const OCR_GROUPS = { o: '0', i: '1', l: '1', s: '5', b: '8', z: '2', g: '6' };
    function canonicalise(s) {
      return s.split('').map(c => OCR_GROUPS[c] ?? c).join('');
    }

    function render(matches, isFuzzy) {
      results.innerHTML = matches.map(m => `
        <a class="plate-result" href="/photo/${m.slug}">
          <span class="plate-result-plate">
            ${m.plate}
            ${isFuzzy ? '<span class="plate-result-fuzzy">possible match</span>' : ''}
          </span>
          <span class="plate-result-title">${m.title}</span>
        </a>
      `).join('');
    }

    input?.addEventListener('input', () => {
      const q = normalise(input.value);
      if (!q) {
        results.innerHTML = '';
        status.textContent = defaultStatus;
        return;
      }
      const exact = plates.filter(p => normalise(p.plate).includes(q));
      if (exact.length) {
        status.textContent = `${exact.length} match${exact.length !== 1 ? 'es' : ''}`;
        render(exact, false);
        return;
      }
      const qCanon = canonicalise(q);
      const fuzzy = plates.filter(p => canonicalise(normalise(p.plate)).includes(qCanon));
      if (fuzzy.length) {
        status.textContent = `${fuzzy.length} possible match${fuzzy.length !== 1 ? 'es' : ''} — the plate reading may be off by a character`;
        render(fuzzy, true);
      } else {
        status.textContent = 'No matches — try just the numbers, or fewer characters.';
        render([], false);
      }
    });

    // Photo pages link here as /plate?q=<plate> ("see every photo of this
    // car") — pick that up and run the search immediately instead of
    // dumping the visitor on an empty box they'd have to retype the plate
    // they just saw into.
    const queryPlate = new URLSearchParams(window.location.search).get('q');
    if (queryPlate && input) {
      input.value = queryPlate;
      input.dispatchEvent(new Event('input'));
    }
  </script>

  <style>
    .plate-search {
      max-width: 32rem;
      margin-top: 1rem;
    }
    #plate-input {
      width: 100%;
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 0.9rem 1.1rem;
      font-size: 1rem;
      font-family: inherit;
      letter-spacing: 0.05em;
    }
    #plate-input:focus {
      outline: none;
      border-color: var(--accent);
    }
    .plate-status {
      font-size: 0.8rem;
      color: var(--text-dim, var(--text-muted));
      margin-top: 0.75rem;
    }
    .plate-results {
      margin-top: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      max-width: 32rem;
    }
    .plate-result {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      padding: 0.9rem 1.1rem;
      border: 1px solid var(--border);
      color: inherit;
      text-decoration: none;
      transition: border-color 0.2s;
    }
    .plate-result:hover {
      border-color: var(--accent);
    }
    .plate-result-fuzzy {
      display: inline-block;
      margin-left: 0.5rem;
      padding: 0.15rem 0.5rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      color: var(--text-dim, var(--text-muted));
      font-family: inherit;
      font-size: 0.65rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      vertical-align: middle;
    }
    .plate-result-plate {
      font-family: var(--font-heading);
      letter-spacing: 0.05em;
      color: var(--accent);
      flex-shrink: 0;
    }
    .plate-result-title {
      color: var(--text-muted);
      font-size: 0.85rem;
      text-align: right;
    }
  </style>
</Layout>
