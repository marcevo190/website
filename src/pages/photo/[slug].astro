---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCaption } from '../../data/captions';
import { events } from '../../data/events';
import ShareButtons from '../../components/ShareButtons.astro';
import SmartBackLink from '../../components/SmartBackLink.astro';
import { extractTags, tagSlug } from '../../data/tags';

// One indexable page per photo — unique title/description, ImageObject
// structured data (drives Google Images' "Licensable" badge), and
// prev/next links that give crawlers a path through the whole archive.
export function getStaticPaths() {
  const imageModules = import.meta.glob<{ default: ImageMetadata }>(
    '/src/assets/watermarked/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
    { eager: true }
  );

  const photos = Object.entries(imageModules)
    .map(([path, mod]) => {
      const parts = path.split('/');
      const filename = parts[parts.length - 1];
      const folder = parts[parts.length - 2];
      return {
        src: mod.default,
        category: folder,
        filename,
        slug: filename.replace(/\.[^.]+$/, '').toLowerCase().replace(/[^a-z0-9]+/g, '-'),
      };
    })
    .sort((a, b) => a.category.localeCompare(b.category) || a.filename.localeCompare(b.filename));

  return photos.map((photo, i) => {
    // Prev/next within the same category, in filename order
    const sameCat = photos.filter(p => p.category === photo.category);
    const idx = sameCat.indexOf(photo);
    const prev = sameCat[(idx - 1 + sameCat.length) % sameCat.length];
    const next = sameCat[(idx + 1) % sameCat.length];
    return {
      params: { slug: photo.slug },
      props: {
        photo,
        prevSlug: prev !== photo ? prev.slug : null,
        nextSlug: next !== photo ? next.slug : null,
      },
    };
  });
}

const { photo, prevSlug, nextSlug } = Astro.props;

const cap = getCaption(photo.filename);
const title = cap?.title ?? photo.filename.replace(/\.[^.]+$/, '');
const caption = cap?.caption ?? '';
const plate = cap?.plate;

const event = events.find(e => e.categories.includes(photo.category));
const imageAbsoluteUrl = new URL(photo.src.src, Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

// Keywords drive Google Images matching — derived from the visible caption,
// the event name and the category label, so searches like "Corvette GT3 Le Mans"
// can actually resolve to this page.
const categoryLabel = event?.name ?? events.find(e => e.categories.includes(photo.category))?.name ?? photo.category;
const stopwords = new Set([
  'is', 'the', 'a', 'an', 'in', 'at', 'on', 'under', 'with', 'of', 'and',
  'for', 'from', 'that', 'this', 'its', 'you', 'your', 'it', 's', 'to', 'be',
]);
const photoTags = extractTags(title);

// Tags first (accurate, curated) then crude word-split filler — the split
// alone drops short-but-meaningful tokens like "M2"/"M3" (<=2 chars).
const keywords = Array.from(new Set([
  ...photoTags,
  ...(title + ' ' + caption + ' ' + categoryLabel + ' ' + photo.category)
    .toLowerCase()
    .replace(/[^a-z0-9\s#]/g, ' ')
    .split(/\s+/)
    .filter(w => w.length > 2 && !stopwords.has(w)),
])).slice(0, 12);

const imageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  contentUrl: imageAbsoluteUrl,
  url: pageUrl,
  name: title,
  description: caption,
  keywords: keywords.join(', '),
  creator: { '@type': 'Person', name: 'Marc Ronan' },
  creditText: 'Marc Ronan / TrackMarc',
  copyrightNotice: `© ${new Date().getFullYear()} Marc Ronan`,
  license: 'https://trackmarc.com/licensing',
  acquireLicensePage: 'https://trackmarc.com/licensing',
};
---

<Layout
  title={`${title} — TrackMarc Motorsport Photography`}
  description={caption || `${title} — motorsport photography by Marc Ronan.`}
  ogImage={photo.src.src}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(imageSchema)} />

  <div style="padding-top: var(--nav-height);">
    <div class="section photo-page">

      <div class="photo-page-nav">
        <SmartBackLink
          href={event ? `/events/${event.slug}` : '/gallery'}
          label={event ? event.name : 'Gallery'}
          class="photo-back"
        />
        <div class="photo-page-arrows">
          {prevSlug && <a href={`/photo/${prevSlug}`} rel="prev">&larr; Previous</a>}
          {nextSlug && <a href={`/photo/${nextSlug}`} rel="next">Next &rarr;</a>}
        </div>
      </div>

      <figure class="photo-page-figure">
        <Image
          src={photo.src}
          alt={title}
          widths={[400, 800, 1200]}
          sizes="(max-width: 900px) 100vw, 80vw"
          loading="eager"
          class="photo-page-img"
        />
        <figcaption class="photo-page-caption">
          <h1 class="photo-page-title">{title}</h1>
          {caption && <p>{caption}</p>}
          {photoTags.length > 0 && (
            <div class="photo-page-tags">
              {photoTags.map(t => <a class="photo-page-tag" href={`/tag/${tagSlug(t)}`}>{t}</a>)}
            </div>
          )}
          {plate && (
            <p class="photo-page-plate">
              Plate spotted: <a href={`/plate?q=${encodeURIComponent(plate)}`}>{plate}</a> — see every photo of this car
            </p>
          )}
          <p class="photo-page-credit">
            &copy; Marc Ronan / TrackMarc · Available for editorial licensing —
            <a href="/licensing">licensing details</a> · <a href="/contact">get in touch</a>
          </p>
          <ShareButtons url={pageUrl} title={title} text={caption} />
        </figcaption>
      </figure>

    </div>
  </div>

  <style>
    .photo-page {
      max-width: 72rem;
      margin: 0 auto;
    }
    .photo-page-nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.25rem;
      font-family: var(--font-heading);
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .photo-page-nav a {
      color: var(--text-muted);
      text-decoration: none;
    }
    .photo-page-nav a:hover { color: var(--accent); }
    .photo-page-arrows { display: flex; gap: 1.25rem; }
    .photo-page-figure { margin: 0; }
    .photo-page-img {
      width: 100%;
      height: auto;
      background: var(--surface);
    }
    .photo-page-caption { margin-top: 1.25rem; max-width: 46rem; }
    .photo-page-title {
      font-family: var(--font-heading);
      font-size: clamp(1.1rem, 2.5vw, 1.6rem);
      margin-bottom: 0.6rem;
    }
    .photo-page-caption p {
      color: var(--text-muted);
      line-height: 1.7;
      margin-bottom: 0.8rem;
    }
    .photo-page-credit {
      font-size: 0.78rem;
      color: var(--text-dim, var(--text-muted));
    }
    .photo-page-credit a { color: var(--accent); }
    .photo-page-plate {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 1rem;
    }
    .photo-page-plate a {
      color: var(--accent);
      font-family: var(--font-heading);
      letter-spacing: 0.05em;
    }
    .photo-page-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }
    .photo-page-tag {
      font-family: var(--font-heading);
      font-size: 0.68rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 0.4rem 0.75rem;
      border: 1px solid var(--border, rgba(255,255,255,0.15));
      color: var(--text-muted);
      text-decoration: none;
      transition: all 0.2s;
    }
    .photo-page-tag:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
  </style>
</Layout>
