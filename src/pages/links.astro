---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getPlateIndex } from '../data/captions';

// A dedicated "link in bio" page — Instagram only allows one bio link, and a
// flat link straight to Buy Me a Coffee doesn't tell a visitor why they'd
// want to tap it. Breaking it into a few clearly-labelled options (per
// Marc's 2026-09-10 analytics review: 651 profile visits but only 38
// external link taps that month) gives people a reason before they click.
const plates = getPlateIndex();

// A real photo behind the card instead of a flat colour — a link-in-bio page
// is the one place every Instagram visitor lands, worth it looking like a
// photographer's page rather than a generic template. Pick one at random
// each build from the same watermarked pool the homepage hero uses.
const galleryModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/watermarked/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
  { eager: true }
);
const bgCandidates = Object.values(galleryModules).map(mod => mod.default);
const bgPhoto = bgCandidates.length
  ? bgCandidates[Math.floor(Math.random() * bgCandidates.length)]
  : null;

// "Search Your Reg" is the standout feature (and the whole reason the plate
// stat exists), so it gets its own highlighted treatment instead of sitting
// in the plain list at the same visual weight as everything else.
const links = [
  {
    emoji: '📸',
    label: 'Get Your Photo',
    desc: "Want the high-res version of your car? Send me a message and I'll get it to you.",
    href: '/contact',
  },
  {
    emoji: '🖼️',
    label: 'Full Portfolio',
    desc: 'Every event, every category.',
    href: '/gallery',
  },
  {
    emoji: '📩',
    label: 'Press & Licensing',
    desc: "Series organisers, media, or want to license a photo?",
    href: '/licensing',
  },
];
---

<Layout
  title="TrackMarc — Links"
  description="Search your reg, browse event galleries, buy a print, or get in touch."
  hideChrome
>
  <div class="links-page">
    {bgPhoto && (
      <div class="links-bg">
        <Image src={bgPhoto} alt="" width={1200} loading="eager" />
      </div>
    )}
    <div class="links-card">
      <a href="/" class="links-brand">
        <span class="links-flag">🇮🇪</span> TRACK<span class="links-brand-accent">MARC</span>
      </a>
      <p class="links-tagline">Motorsport &amp; Automotive Photography</p>
      {plates.length > 0 && (
        <p class="links-stat">{plates.length} photographs have a plate on record</p>
      )}

      <a class="links-featured" href="/plate">
        <span class="links-featured-emoji">🔍</span>
        <span class="links-item-text">
          <span class="links-item-label">Search Your Reg</span>
          <span class="links-item-desc">Find every photo of your car by registration plate.</span>
        </span>
      </a>

      <div class="links-list">
        {links.map(link => (
          <a class="links-item" href={link.href}>
            <span class="links-item-emoji">{link.emoji}</span>
            <span class="links-item-text">
              <span class="links-item-label">{link.label}</span>
              <span class="links-item-desc">{link.desc}</span>
            </span>
          </a>
        ))}
      </div>

      <div class="links-support">
        <p class="links-support-label">Enjoying the photos?</p>
        <a href="https://www.buymeacoffee.com/TrackMarc" target="_blank" rel="noopener" class="links-bmc">
          <img
            src="https://img.buymeacoffee.com/button-api/?text=Buy me a coffee&emoji=☕&slug=TrackMarc&button_colour=40DCA5&font_colour=ffffff&font_family=Poppins&outline_colour=000000&coffee_colour=FFDD00"
            alt="Buy Me a Coffee"
          />
        </a>
      </div>

      <a href="/" class="links-back">trackmarc.com &rarr;</a>
    </div>
  </div>
</Layout>

<style>
  .links-page {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2.5rem 1.25rem;
    overflow: hidden;
  }
  .links-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
  }
  .links-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(18px) brightness(0.45) saturate(1.1);
    transform: scale(1.1);
  }
  .links-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 60% at 50% 30%, rgba(13,17,20,0.55) 0%, rgba(8,8,8,0.88) 100%);
  }
  .links-card {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 26rem;
    text-align: center;
  }
  .links-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    letter-spacing: 0.04em;
  }
  .links-brand-accent { color: var(--accent); }
  .links-flag { font-size: 1.1rem; }
  .links-tagline {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-top: 0.5rem;
  }
  .links-stat {
    color: var(--text-dim);
    font-size: 0.75rem;
    margin-top: 0.35rem;
  }
  .links-featured {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    background: linear-gradient(135deg, rgba(0,210,190,0.16), rgba(0,210,190,0.05));
    border: 1px solid var(--accent);
    border-radius: 12px;
    padding: 1.1rem 1.2rem;
    text-align: left;
    box-shadow: 0 0 24px rgba(0,210,190,0.12);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .links-featured:hover, .links-featured:active {
    transform: translateY(-1px);
    box-shadow: 0 0 32px rgba(0,210,190,0.2);
  }
  .links-featured-emoji { font-size: 1.7rem; flex-shrink: 0; }
  .links-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .links-item {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    background: rgba(20,22,24,0.7);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.9rem 1.1rem;
    text-align: left;
    transition: border-color 0.2s, background 0.2s;
  }
  .links-item:hover, .links-item:active {
    border-color: var(--accent);
    background: var(--surface-2);
  }
  .links-item-emoji { font-size: 1.4rem; flex-shrink: 0; }
  .links-item-text { display: flex; flex-direction: column; gap: 0.15rem; }
  .links-item-label {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .links-item-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.4;
  }
  .links-support {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .links-support-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }
  .links-bmc {
    display: flex;
    justify-content: center;
  }
  .links-bmc img { height: auto; }
  .links-back {
    display: inline-block;
    margin-top: 2rem;
    color: var(--text-dim);
    font-size: 0.8rem;
  }
  .links-back:hover { color: var(--text-muted); }
</style>
