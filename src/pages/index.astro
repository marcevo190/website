---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { events } from '../data/events';
import { getCaption } from '../data/captions';

// Gallery images for carousel rotation — shuffled across all categories.
// Glob covers all of watermarked/ (generated from src/data/categories.json).
const galleryModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/watermarked/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
  { eager: true }
);

// Event coverage cards — cover image + photo count per event
const eventCards = events.map(event => {
  let cover: ImageMetadata | null = null;
  let count = 0;
  for (const [path, mod] of Object.entries(galleryModules)) {
    const parts = path.split('/');
    const filename = parts[parts.length - 1];
    const folder = parts[parts.length - 2];
    if (!event.categories.includes(folder)) continue;
    count++;
    if (filename === event.hero) cover = mod.default;
  }
  return { event, cover, count };
});

// Keep a caption alongside each slide so hero <img> alt text stays meaningful
const slideEntries = Object.entries(galleryModules).map(([path, mod]) => {
  const parts = path.split('/');
  const filename = parts[parts.length - 1];
  return { src: mod.default, filename };
});
// Fisher-Yates shuffle
for (let i = slideEntries.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [slideEntries[i], slideEntries[j]] = [slideEntries[j], slideEntries[i]];
}
// Cap the hero carousel to rendering all ~135 photos; a handful is plenty.
const slides = slideEntries.slice(0, 10);
---

<Layout title="TrackMarc — Irish Motorsport Photography | Marc Ronan">
  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg"></div>

    <!-- Carousel -->
    {slides.length > 0 && (
      <div class="hero-carousel" id="hero-carousel">
        {slides.map((slide, i) => (
          <div class:list={['carousel-slide', { active: i === 0 }]}>
            <Image
              src={slide.src}
              alt={getCaption(slide.filename)?.title ?? 'Motorsport photography by TrackMarc'}
              class="carousel-img"
              widths={[800, 1440, 1920]}
              sizes="100vw"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          </div>
        ))}
        <div class="carousel-overlay"></div>
      </div>
    )}

    <div class="hero-content">
      <p class="hero-eyebrow">Motorsport Photography</p>
      <h1>Where Speed<br />Meets <em>Lens</em></h1>
      <p class="hero-desc">
        Capturing the raw intensity of motorsport — from Formula 2 to endurance classics.
        Available for media accreditation and editorial commissions.
      </p>
      <div class="hero-actions">
        <a href="/gallery" class="btn btn-primary">View Portfolio</a>
        <a href="/contact" class="btn btn-outline">Press Inquiry</a>
      </div>
    </div>

    <div class="hero-scroll">Scroll</div>
  </section>

  <!-- EVENT COVERAGE -->
  {eventCards.length > 0 && (
    <div class="section">
      <div class="section-header">
        <p class="section-eyebrow">Latest Coverage</p>
        <h2 class="section-title">Event Galleries</h2>
        <p class="section-subtitle">Complete photo sets from recent race weekends.</p>
      </div>
      <div class="home-event-cards">
        {eventCards.map(({ event, cover, count }) => (
          <a href={`/events/${event.slug}`} class="home-event-card">
            {cover && (
              <Image
                src={cover}
                alt={event.name}
                widths={[600, 1000, 1400]}
                sizes="(max-width: 768px) 100vw, 50vw"
                class="home-event-img"
              />
            )}
            <div class="home-event-overlay"></div>
            <div class="home-event-meta">
              <p class="home-event-name">{event.name}</p>
              <p class="home-event-detail">{event.venue}</p>
              <p class="home-event-count">{count} photographs · {event.season}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- PRESS CTA BANNER -->
  <div class="press-cta-wrap">
    <div class="press-cta">
      <div>
        <p class="section-eyebrow">Media Accreditation</p>
        <h3 class="press-cta-title">Covering Your Event?</h3>
        <p class="press-cta-desc">
          I'm actively seeking media credentials at FIA, ACO, and national-level events.
          If you're a press officer or series coordinator, let's talk.
        </p>
      </div>
      <a href="/contact" class="btn btn-primary press-cta-btn">Get in Touch &rarr;</a>
    </div>
  </div>
</Layout>

<script>
  const slides = document.querySelectorAll<HTMLElement>('.carousel-slide');
  if (slides.length > 1) {
    let current = 0;
    setInterval(() => {
      slides[current].classList.remove('active');
      current = (current + 1) % slides.length;
      slides[current].classList.add('active');
    }, 5000);
  }
</script>

<style>
  /* ── Event coverage cards ── */
  .home-event-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    gap: 1.5rem;
  }
  .home-event-card {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface);
    text-decoration: none;
    color: inherit;
  }
  .home-event-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .home-event-card:hover .home-event-img {
    transform: scale(1.04);
  }
  .home-event-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(13,17,20,0.05) 40%, rgba(13,17,20,0.9) 100%);
  }
  .home-event-meta {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 1.5rem;
  }
  .home-event-name {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    margin-bottom: 0.3rem;
  }
  .home-event-detail {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 0.2rem;
  }
  .home-event-count {
    font-size: 0.72rem;
    color: var(--text-dim, var(--text-muted));
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ── Carousel ── */
  .hero-carousel {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .carousel-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.5s ease;
  }
  .carousel-slide.active { opacity: 1; }
  .carousel-img {
    position: absolute;
    top: 0; right: 0;
    width: 62%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.6) 12%, black 28%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.6) 12%, black 28%);
  }
  /* Desktop overlay — subtle dark gradient over image area */
  .carousel-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 60%, rgba(13,17,20,0.9) 100%);
    z-index: 1;
    pointer-events: none;
  }

  /* ── Mobile: full-bleed cover image ── */
  @media (max-width: 768px) {
    .carousel-img {
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center center;
      mask-image: none;
      -webkit-mask-image: none;
      opacity: 0.85;
    }
    /* Stronger gradient so the headline stays legible over a full photo */
    .carousel-overlay {
      background:
        linear-gradient(to bottom, rgba(13,17,20,0.55) 0%, rgba(13,17,20,0.35) 38%, rgba(13,17,20,0.82) 78%, rgba(13,17,20,0.97) 100%);
    }
  }

  /* ── Press CTA ── */
  .press-cta-wrap {
    padding: 0 2rem;
    margin-bottom: 6rem;
  }
  .press-cta {
    max-width: var(--max-width);
    margin: 0 auto;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    padding: 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .press-cta-title {
    font-size: clamp(1.4rem, 3vw, 2rem);
    margin: 0.5rem 0;
  }
  .press-cta-desc {
    color: var(--text-muted);
    font-weight: 300;
    margin-top: 0.5rem;
    max-width: 480px;
  }
  .press-cta-btn { flex-shrink: 0; }

  @media (max-width: 768px) {
    .press-cta-wrap { padding: 0 1.25rem; margin-bottom: 3rem; }
    .press-cta { padding: 1.75rem 1.25rem; flex-direction: column; align-items: flex-start; }
    .press-cta-btn { width: 100%; justify-content: center; }
  }
</style>
