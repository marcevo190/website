---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCaption } from '../../data/captions';
import { events } from '../../data/events';
import ShareButtons from '../../components/ShareButtons.astro';

export function getStaticPaths() {
  return events.map(event => ({ params: { slug: event.slug }, props: { event } }));
}

const { event } = Astro.props;

// Same source as the gallery — watermarked copies generated at build
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/watermarked/{formula,endurance,rally,gt,car-shows,iccr}/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
  { eager: true }
);

const photos = Object.entries(imageModules)
  .map(([path, mod]) => {
    const parts = path.split('/');
    const filename = parts[parts.length - 1];
    const folder = parts[parts.length - 2];
    const cap = getCaption(filename);
    return {
      src: mod.default,
      category: folder,
      filename,
      title: cap?.title ?? filename.replace(/\.[^.]+$/, ''),
      caption: cap?.caption ?? '',
      pageSlug: filename.replace(/\.[^.]+$/, '').toLowerCase().replace(/[^a-z0-9]+/g, '-'),
    };
  })
  .filter(p => event.categories.includes(p.category))
  .sort((a, b) => a.filename.localeCompare(b.filename));

const heroPhoto = photos.find(p => p.filename === event.hero) ?? photos[0];
const eventPageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<Layout title={`${event.name} — TrackMarc Motorsport Photography`} description={event.description}>
  <div style="padding-top: var(--nav-height);">

    <!-- EVENT HERO -->
    {heroPhoto && (
      <div class="event-hero">
        <Image
          src={heroPhoto.src}
          alt={heroPhoto.title}
          class="event-hero-img"
          widths={[800, 1440, 1920]}
          sizes="100vw"
          loading="eager"
        />
        <div class="event-hero-overlay"></div>
        <div class="event-hero-content">
          <p class="section-eyebrow">Event Coverage</p>
          <h1 class="event-hero-title">{event.name}</h1>
          <p class="event-hero-meta">{event.venue} · {event.season} · {photos.length} photographs</p>
        </div>
      </div>
    )}

    <!-- INTRO -->
    <div class="section" style="padding-bottom: 1rem;">
      <div class="event-intro">
        {event.intro.map(par => <p>{par}</p>)}
        <div class="event-classes">
          {event.classes.map(c => <span class="event-class-chip">{c}</span>)}
        </div>
        <ShareButtons url={eventPageUrl} title={event.name} text={`Photo coverage: ${event.name} at ${event.venue}`} />
      </div>
    </div>

    <!-- PHOTOS -->
    <div class="section" style="padding-top: 1rem;">
      <div class="gallery-masonry" id="gallery">
        {photos.map(photo => (
          <div
            class="photo-card"
            data-title={photo.title}
            data-caption={photo.caption}
            data-slug={photo.pageSlug}
          >
            <Image
              src={photo.src}
              alt={photo.title}
              widths={[400, 800, 1200]}
              sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
            />
            <div class="photo-card-overlay">
              <div class="photo-card-meta">
                <a class="photo-card-title" href={`/photo/${photo.pageSlug}`} style="color:inherit;text-decoration:none;">{photo.title}</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- PRESS + DRIVER CTA -->
    <div class="press-cta-wrap">
      <div class="press-cta">
        <div>
          <p class="section-eyebrow">Press &amp; Drivers</p>
          <h3 class="press-cta-title">Involved With This Event?</h3>
          <p class="press-cta-desc">
            Series and event organisers: I'm available for media coverage and social-ready photography.
            Drivers pictured here: your photos are free for personal social media use with credit — just ask.
          </p>
        </div>
        <a href="/contact" class="btn btn-primary press-cta-btn">Get in Touch &rarr;</a>
      </div>
    </div>
  </div>

  <!-- Lightbox -->
  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" id="lightbox-close">&#x2715; Close</button>
    <button class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Previous">&#8592;</button>
    <img class="lightbox-img" id="lightbox-img" src="" alt="" />
    <button class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Next">&#8594;</button>
    <div class="lightbox-meta">
      <div class="photo-card-title" id="lightbox-title"></div>
      <p class="lightbox-caption" id="lightbox-caption"></p>
      <div class="share-row" id="lb-share">
        <button type="button" class="share-btn share-btn--main" id="lb-share-native" aria-label="Share">
          <svg viewBox="0 0 24 24"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81a3 3 0 1 0-3-3c0 .24.04.47.09.7L8.04 9.81A3 3 0 1 0 5 15a3 3 0 0 0 2.96-2.99l7.13 4.16c-.05.21-.08.43-.08.65a3 3 0 1 0 3-2.74z"/></svg>
          Share
        </button>
        <button type="button" class="share-btn" id="lb-share-ig" aria-label="Share to Instagram">
          <svg viewBox="0 0 24 24"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.64.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.15-3.23 1.66-4.77 4.92-4.92 1.27-.06 1.65-.07 4.85-.07zM12 0C8.74 0 8.33.01 7.05.07 2.7.27.27 2.7.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.35 2.63 6.78 6.98 6.98C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c4.35-.2 6.78-2.63 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.2-4.35-2.62-6.78-6.98-6.98C15.67.01 15.26 0 12 0zm0 5.84A6.16 6.16 0 1 0 18.16 12 6.16 6.16 0 0 0 12 5.84zM12 16a4 4 0 1 1 4-4 4 4 0 0 1-4 4zm6.41-10.85a1.44 1.44 0 1 1-1.44-1.44 1.44 1.44 0 0 1 1.44 1.44z"/></svg>
        </button>
        <a class="share-btn" id="lb-share-wa" target="_blank" rel="noopener" aria-label="Share on WhatsApp">
          <svg viewBox="0 0 24 24"><path d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.45 1.32 4.95L2 22l5.24-1.37a9.9 9.9 0 0 0 4.8 1.23h.01c5.5 0 9.96-4.46 9.96-9.96S17.54 2 12.04 2zm0 18.2a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.11.82.83-3.03-.2-.31a8.24 8.24 0 1 1 6.97 3.85zm4.52-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.4-.12-.56.13-.17.25-.65.81-.79.97-.15.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23a7.5 7.5 0 0 1-1.38-1.72c-.15-.25-.02-.38.11-.5.11-.11.25-.29.37-.44.12-.15.16-.25.25-.42.08-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.86-.87 2.09s.9 2.42 1.02 2.59c.12.17 1.77 2.7 4.28 3.79.6.26 1.06.41 1.43.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.19.21-.58.21-1.08.15-1.19-.06-.1-.23-.17-.48-.29z"/></svg>
        </a>
        <a class="share-btn" id="lb-share-fb" target="_blank" rel="noopener" aria-label="Share on Facebook">
          <svg viewBox="0 0 24 24"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg>
        </a>
        <a class="share-btn" id="lb-share-x" target="_blank" rel="noopener" aria-label="Share on X">
          <svg viewBox="0 0 24 24"><path d="M18.9 2H22l-7.19 8.21L23.3 22h-6.62l-5.18-6.78L5.5 22H2.38l7.7-8.8L1 2h6.79l4.68 6.2zm-1.16 18.17h1.73L7.35 3.75H5.5z"/></svg>
        </a>
        <button type="button" class="share-btn" id="lb-share-copy" aria-label="Copy link">
          <svg viewBox="0 0 24 24"><path d="M3.9 12a3.1 3.1 0 0 1 3.1-3.1h4v-1.8H7a4.9 4.9 0 0 0 0 9.8h4v-1.8H7A3.1 3.1 0 0 1 3.9 12zM8 13h8v-2H8zm9-6.9h-4v1.8h4a3.1 3.1 0 0 1 0 6.2h-4v1.8h4a4.9 4.9 0 0 0 0-9.8z"/></svg>
        </button>
        <span class="share-toast" id="lb-share-toast">Link copied</span>
      </div>
    </div>
  </div>

  <script>
    const cards = document.querySelectorAll<HTMLElement>('#gallery .photo-card');
    const lightbox = document.getElementById('lightbox');
    const lbImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lbTitle = document.getElementById('lightbox-title');
    const lbCaption = document.getElementById('lightbox-caption');
    const lbClose = document.getElementById('lightbox-close');
    const lbPrev = document.getElementById('lightbox-prev');
    const lbNext = document.getElementById('lightbox-next');

    // Share row — hrefs/state refreshed on every showCard() call
    const lbShareNative = document.getElementById('lb-share-native');
    const lbShareIg = document.getElementById('lb-share-ig');
    const lbShareWa = document.getElementById('lb-share-wa') as HTMLAnchorElement | null;
    const lbShareFb = document.getElementById('lb-share-fb') as HTMLAnchorElement | null;
    const lbShareX  = document.getElementById('lb-share-x') as HTMLAnchorElement | null;
    const lbShareCopy = document.getElementById('lb-share-copy');
    const lbShareToast = document.getElementById('lb-share-toast');
    let shareUrl = '';
    let shareTitle = '';

    function copyShareLink(message = 'Link copied') {
      navigator.clipboard?.writeText(shareUrl).then(() => {
        if (lbShareToast) lbShareToast.textContent = message;
        lbShareToast?.classList.add('show');
        setTimeout(() => lbShareToast?.classList.remove('show'), 2500);
      });
    }
    lbShareNative?.addEventListener('click', async (e) => {
      e.stopPropagation();
      const nav = navigator as Navigator & { share?: (data: ShareData) => Promise<void> };
      if (nav.share) {
        try { await nav.share({ title: shareTitle, url: shareUrl }); return; } catch { /* cancelled/unsupported */ }
      }
      copyShareLink();
    });
    // Instagram has no share-by-link web intent — on mobile this opens the same OS
    // share sheet (Instagram is one of the listed apps); on desktop it copies the
    // link with Instagram-specific instructions instead of the generic message.
    lbShareIg?.addEventListener('click', async (e) => {
      e.stopPropagation();
      const nav = navigator as Navigator & { share?: (data: ShareData) => Promise<void> };
      if (nav.share) {
        try { await nav.share({ title: shareTitle, url: shareUrl }); return; } catch { /* cancelled/unsupported */ }
      }
      copyShareLink('Link copied — paste into Instagram');
    });
    lbShareCopy?.addEventListener('click', (e) => { e.stopPropagation(); copyShareLink(); });
    [lbShareWa, lbShareFb, lbShareX].forEach(a => a?.addEventListener('click', (e) => e.stopPropagation()));

    let currentIndex = 0;
    const cardList = Array.from(cards);

    function showCard(index: number) {
      if (!cardList.length) return;
      currentIndex = (index + cardList.length) % cardList.length;
      const card = cardList[currentIndex];
      const img = card.querySelector('img');
      if (lbImg && img) { lbImg.src = img.src; lbImg.alt = img.alt; }
      if (lbTitle) lbTitle.textContent = card.dataset.title ?? '';
      if (lbCaption) lbCaption.textContent = card.dataset.caption ?? '';

      shareTitle = card.dataset.title ?? '';
      const slug = card.dataset.slug;
      shareUrl = slug ? `${location.origin}/photo/${slug}/` : location.href;
      if (lbShareWa) lbShareWa.href = `https://wa.me/?text=${encodeURIComponent(`${shareTitle}\n${shareUrl}`)}`;
      if (lbShareFb) lbShareFb.href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`;
      if (lbShareX)  lbShareX.href  = `https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(shareTitle)}`;
    }

    cardList.forEach(card => {
      card.addEventListener('click', (e) => {
        // Title links navigate to the photo's own page; everything else opens the lightbox
        if ((e.target as HTMLElement).closest('a')) return;
        currentIndex = cardList.indexOf(card);
        showCard(currentIndex);
        lightbox?.classList.add('open');
      });
    });

    lbPrev?.addEventListener('click', (e) => { e.stopPropagation(); showCard(currentIndex - 1); });
    lbNext?.addEventListener('click', (e) => { e.stopPropagation(); showCard(currentIndex + 1); });
    lbClose?.addEventListener('click', () => lightbox?.classList.remove('open'));
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) lightbox.classList.remove('open');
    });
    document.addEventListener('keydown', (e) => {
      if (!lightbox?.classList.contains('open')) return;
      if (e.key === 'Escape') lightbox.classList.remove('open');
      if (e.key === 'ArrowLeft') showCard(currentIndex - 1);
      if (e.key === 'ArrowRight') showCard(currentIndex + 1);
    });
  </script>

  <style>
    .event-hero {
      position: relative;
      height: min(62vh, 560px);
      overflow: hidden;
      background: var(--surface);
    }
    .event-hero-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }
    .event-hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, rgba(13,17,20,0.25) 0%, rgba(13,17,20,0.35) 55%, rgba(13,17,20,0.92) 100%);
    }
    .event-hero-content {
      position: absolute;
      left: 0; right: 0; bottom: 0;
      padding: 2.5rem clamp(1.5rem, 5vw, 4rem);
    }
    .event-hero-title {
      font-family: var(--font-heading);
      font-size: clamp(1.8rem, 4.5vw, 3.2rem);
      line-height: 1.05;
      margin: 0.4rem 0 0.6rem;
    }
    .event-hero-meta {
      font-size: 0.85rem;
      color: var(--text-muted);
      letter-spacing: 0.04em;
    }
    .event-intro {
      max-width: 46rem;
    }
    .event-intro p {
      color: var(--text-muted);
      line-height: 1.75;
      margin-bottom: 1.1rem;
    }
    .event-classes {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 1.4rem;
    }
    .event-class-chip {
      font-family: var(--font-heading);
      font-size: 0.68rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 0.4rem 0.75rem;
      border: 1px solid var(--border, rgba(255,255,255,0.15));
      color: var(--text-muted);
    }
  </style>
</Layout>
