---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { events } from '../../data/events';

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/watermarked/{formula,endurance,rally,gt,car-shows,iccr,bimmerfest}/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
  { eager: true }
);

// Resolve each event's cover image and photo count from the watermarked assets
const cards = events.map(event => {
  let cover: ImageMetadata | null = null;
  let count = 0;
  for (const [path, mod] of Object.entries(imageModules)) {
    const parts = path.split('/');
    const filename = parts[parts.length - 1];
    const folder = parts[parts.length - 2];
    if (!event.categories.includes(folder)) continue;
    count++;
    if (filename === event.hero) cover = mod.default;
  }
  return { event, cover, count };
});
---

<Layout
  title="Events — TrackMarc Motorsport Photography"
  description="Full event photo coverage by Marc Ronan — the Le Mans 24 Hours and Irish Championship Circuit Racing at Mondello Park."
>
  <div style="padding-top: var(--nav-height);">
    <div class="section">
      <div class="section-header">
        <p class="section-eyebrow">Coverage</p>
        <h1 class="section-title">Events</h1>
        <p class="section-subtitle">
          Complete photo sets from race weekends — paddock to podium, grid to night running.
        </p>
      </div>

      <div class="event-cards">
        {cards.map(({ event, cover, count }) => (
          <a href={`/events/${event.slug}`} class="event-cover-card">
            {cover && (
              <Image
                src={cover}
                alt={event.name}
                widths={[600, 1000, 1400]}
                sizes="(max-width: 768px) 100vw, 50vw"
                class="event-cover-img"
              />
            )}
            <div class="event-cover-overlay"></div>
            <div class="event-cover-meta">
              <p class="event-cover-name">{event.name}</p>
              <p class="event-cover-detail">{event.venue}</p>
              <p class="event-cover-count">{count} photographs · {event.season}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>

  <style>
    .event-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
      gap: 1.5rem;
    }
    .event-cover-card {
      position: relative;
      display: block;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      background: var(--surface);
      text-decoration: none;
      color: inherit;
    }
    .event-cover-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s ease;
    }
    .event-cover-card:hover .event-cover-img {
      transform: scale(1.04);
    }
    .event-cover-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, rgba(13,17,20,0.05) 40%, rgba(13,17,20,0.9) 100%);
    }
    .event-cover-meta {
      position: absolute;
      left: 0; right: 0; bottom: 0;
      padding: 1.5rem;
    }
    .event-cover-name {
      font-family: var(--font-heading);
      font-size: 1.25rem;
      margin-bottom: 0.3rem;
    }
    .event-cover-detail {
      font-size: 0.82rem;
      color: var(--text-muted);
      margin-bottom: 0.2rem;
    }
    .event-cover-count {
      font-size: 0.72rem;
      color: var(--text-dim, var(--text-muted));
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
  </style>
</Layout>
