---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  hideChrome?: boolean;
}

const {
  title,
  description = 'Marc Ronan — Irish motorsport photographer covering ICCR at Mondello Park, the Le Mans 24 Hours, F1 and F2 across Ireland and Europe.',
  ogImage = '/og-default.jpg',
  hideChrome = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : new URL(ogImage, Astro.site).href;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:alt" content="TrackMarc — Motorsport Photography" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Marc Ronan",
      "jobTitle": "Motorsport Photographer",
      "url": "https://trackmarc.com",
      "sameAs": ["https://instagram.com/trackmarcdotcom"],
      "knowsAbout": ["Motorsport Photography", "Irish Motorsport", "Irish Championship Circuit Racing", "Mondello Park", "Formula 1", "FIA WEC", "GT Racing", "Rally"],
      "address": { "@type": "PostalAddress", "addressCountry": "IE" },
      "image": `${Astro.site}og-default.jpg`
    })} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class="protect-images">
    {!hideChrome && (
      <>
        <nav class="nav" id="main-nav">
          <a href="/" class="nav-logo">
            <span class="nav-flag">
              <span style="background:#169B62;"></span>
              <span style="background:#FFFFFF;"></span>
              <span style="background:#FF883E;"></span>
            </span>
            Track<span>Marc</span>
          </a>
          <ul class="nav-links">
            <li><a href="/" class:list={[{ active: currentPath === '/' }]}>Home</a></li>
            <li><a href="/portfolio" class:list={[{ active: currentPath.startsWith('/portfolio') }]}>Portfolio</a></li>
            <li><a href="/gallery" class:list={[{ active: currentPath.startsWith('/gallery') }]}>Gallery</a></li>
            <li><a href="/events" class:list={[{ active: currentPath.startsWith('/events') }]}>Events</a></li>
            <li><a href="/coverage" class:list={[{ active: currentPath.startsWith('/coverage') }]}>Coverage</a></li>
            <li><a href="/motorsport" class:list={[{ active: currentPath.startsWith('/motorsport') }]}>Motorsport</a></li>
            <li><a href="/about" class:list={[{ active: currentPath.startsWith('/about') }]}>About</a></li>
            <li><a href="/contact" class:list={[{ active: currentPath.startsWith('/contact') }]}>Contact</a></li>
          </ul>
          <a href="/contact" class="nav-cta">Get in Touch</a>
          <button class="nav-hamburger" id="hamburger" aria-label="Open menu">
            <span></span><span></span><span></span>
          </button>
        </nav>

        <div class="mobile-menu" id="mobile-menu">
          <a href="/" onclick="closeMobileMenu()">Home</a>
          <a href="/portfolio" onclick="closeMobileMenu()">Portfolio</a>
          <a href="/gallery" onclick="closeMobileMenu()">Gallery</a>
          <a href="/events" onclick="closeMobileMenu()">Events</a>
          <a href="/coverage" onclick="closeMobileMenu()">Coverage</a>
          <a href="/motorsport" onclick="closeMobileMenu()">Motorsport</a>
          <a href="/about" onclick="closeMobileMenu()">About</a>
          <a href="/contact" onclick="closeMobileMenu()">Contact</a>
          <a href="/contact" class="mobile-cta" onclick="closeMobileMenu()">Press Inquiry</a>
        </div>
      </>
    )}

    <div class="page-content">
      <slot />
    </div>

    {!hideChrome && (
      <footer class="footer">
        <div class="footer-logo">Track<span>Marc</span></div>
        <p class="footer-copy">
          &copy; {new Date().getFullYear()} Marc Ronan. All images protected by copyright.
          <a href="/licensing" style="color:var(--accent);margin-left:0.4em;">Licensing ↗</a>
        </p>
        <p class="footer-copy">
          Photo titles are identified with AI assistance to process new shoots faster — if one's
          wrong, <a href="/contact" style="color:var(--accent);">let me know</a> and I'll fix it.
        </p>
        <div class="footer-links">
          <a href="/portfolio">Portfolio</a>
          <a href="/gallery">Gallery</a>
          <a href="/about">About</a>
          <a href="/licensing">Licensing</a>
          <a href="/contact">Contact</a>
          <a href="mailto:info@trackmarc.com">info@trackmarc.com</a>
          <a href="https://instagram.com/trackmarcdotcom" target="_blank" rel="noopener">Instagram ↗</a>
        </div>
      </footer>
    )}

    <script
      is:inline
      data-name="BMC-Widget"
      data-cfasync="false"
      src="https://cdnjs.buymeacoffee.com/1.0.0/widget.prod.min.js"
      data-id="TrackMarc"
      data-description="Support me on Buy me a coffee!"
      data-message=""
      data-color="#40DCA5"
      data-position="Right"
      data-x_margin="18"
      data-y_margin="18"
    ></script>

    <script>
      const nav = document.getElementById('main-nav');
      const hamburger = document.getElementById('hamburger');
      const mobileMenu = document.getElementById('mobile-menu');

      window.addEventListener('scroll', () => {
        nav?.classList.toggle('scrolled', window.scrollY > 40);
      }, { passive: true });

      hamburger?.addEventListener('click', () => {
        const isOpen = mobileMenu?.classList.toggle('open');
        hamburger.classList.toggle('open', isOpen);
        document.body.style.overflow = isOpen ? 'hidden' : '';
      });

      (window as any).closeMobileMenu = () => {
        mobileMenu?.classList.remove('open');
        hamburger?.classList.remove('open');
        document.body.style.overflow = '';
      };
    </script>

    <script>
      // Deters casual "long-press / right-click / drag to save" on photos —
      // doesn't stop screenshots (nothing on the web can) or anyone who opens
      // dev tools, but it does stop the average visitor's one-tap save.
      // Marc uses the site itself to grab casual reposts, so this needs to
      // stay off for him: visiting once with ?unlock=<token> remembers the
      // choice in this browser via localStorage, no login needed.
      const UNLOCK_PARAM = 'trackmarc-unlock-2026';
      const UNLOCK_KEY = 'tm_img_unlock';

      const params = new URLSearchParams(window.location.search);
      if (params.get('unlock') === UNLOCK_PARAM) {
        localStorage.setItem(UNLOCK_KEY, '1');
      }

      if (localStorage.getItem(UNLOCK_KEY) === '1') {
        document.body.classList.remove('protect-images');
      } else {
        // Best-effort: find which photo this <img> actually is, so the
        // popup can send the visitor straight to a contact form that
        // already knows what they're asking for. Gallery/event cards carry
        // data-slug; a photo page's own URL already is the reference.
        function photoRefFor(img: HTMLImageElement): string | null {
          const card = img.closest<HTMLElement>('[data-slug]');
          if (card?.dataset.slug) return card.dataset.slug;
          const link = img.closest<HTMLAnchorElement>('a[href^="/photo/"]');
          if (link) return link.getAttribute('href')!.replace(/^\/photo\//, '').replace(/\/$/, '');
          const pageMatch = window.location.pathname.match(/^\/photo\/([^/]+)\/?$/);
          return pageMatch ? pageMatch[1] : null;
        }

        let popupEl: HTMLElement | null = null;
        function showSavePopup(img: HTMLImageElement) {
          popupEl?.remove();
          const ref = photoRefFor(img);
          const href = ref ? `/contact?photo=${encodeURIComponent(ref)}` : '/contact';
          const el = document.createElement('div');
          el.className = 'save-photo-popup';
          el.innerHTML = `
            <p>Want this one without the watermark? I'll send it to you free — just ask.
            A coffee helps keep this going ☕</p>
            <div class="save-photo-popup-actions">
              <a href="${href}">Get this photo &rarr;</a>
              <button type="button" aria-label="Dismiss">&times;</button>
            </div>
          `;
          document.body.appendChild(el);
          popupEl = el;
          el.querySelector('button')?.addEventListener('click', () => el.remove());
          setTimeout(() => { if (popupEl === el) el.remove(); }, 12000);
        }

        document.addEventListener('contextmenu', e => {
          if (e.target instanceof HTMLImageElement) {
            e.preventDefault();
            showSavePopup(e.target);
          }
        });
        document.addEventListener('dragstart', e => {
          if (e.target instanceof HTMLImageElement) e.preventDefault();
        });

        // Long-press on touch devices — no native "long-press" event exists,
        // so this is a simple hold-timer: if the finger hasn't lifted or
        // moved after 500ms, treat it the same as a blocked right-click.
        let pressTimer: ReturnType<typeof setTimeout> | undefined;
        document.addEventListener('touchstart', e => {
          const target = e.target;
          if (!(target instanceof HTMLImageElement)) return;
          pressTimer = setTimeout(() => showSavePopup(target), 500);
        }, { passive: true });
        document.addEventListener('touchend', () => clearTimeout(pressTimer));
        document.addEventListener('touchmove', () => clearTimeout(pressTimer));
      }
    </script>

    <script>
      // Visit counting continues silently in the background (KV via /api/visits);
      // the public odometer display was removed to keep the footer professional.
      (async () => {
        const today = new Date().toISOString().slice(0, 10);
        if (localStorage.getItem('tm_visit_day') === today) return;
        try {
          await fetch('/api/visits', { method: 'POST' });
          localStorage.setItem('tm_visit_day', today);
        } catch {
          // Ignore — counting is best-effort
        }
      })();
    </script>
  </body>
</html>
