---
// One-click sharing for a single photo or gallery — a native "Share" button
// (opens the OS share sheet on mobile, which lists Instagram, WhatsApp, Messages,
// etc.) plus always-available direct links for WhatsApp/Facebook/X and a
// copy-link fallback for anywhere the Web Share API isn't supported.
interface Props {
  url: string;   // absolute URL
  title: string;
  text?: string;
}
const { url, title, text = '' } = Astro.props;

const waHref = `https://wa.me/?text=${encodeURIComponent(`${title}\n${url}`)}`;
const fbHref = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
const xHref  = `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`;
---

<div class="share-row" data-share data-url={url} data-title={title} data-text={text}>
  <button type="button" class="share-btn share-btn--main" data-share-native aria-label="Share">
    <svg viewBox="0 0 24 24"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81a3 3 0 1 0-3-3c0 .24.04.47.09.7L8.04 9.81A3 3 0 1 0 5 15a3 3 0 0 0 2.96-2.99l7.13 4.16c-.05.21-.08.43-.08.65a3 3 0 1 0 3-2.74z"/></svg>
    Share
  </button>
  <a class="share-btn" href={waHref} target="_blank" rel="noopener" aria-label="Share on WhatsApp">
    <svg viewBox="0 0 24 24"><path d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.45 1.32 4.95L2 22l5.24-1.37a9.9 9.9 0 0 0 4.8 1.23h.01c5.5 0 9.96-4.46 9.96-9.96S17.54 2 12.04 2zm0 18.2a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.11.82.83-3.03-.2-.31a8.24 8.24 0 1 1 6.97 3.85zm4.52-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.4-.12-.56.13-.17.25-.65.81-.79.97-.15.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23a7.5 7.5 0 0 1-1.38-1.72c-.15-.25-.02-.38.11-.5.11-.11.25-.29.37-.44.12-.15.16-.25.25-.42.08-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.86-.87 2.09s.9 2.42 1.02 2.59c.12.17 1.77 2.7 4.28 3.79.6.26 1.06.41 1.43.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.19.21-.58.21-1.08.15-1.19-.06-.1-.23-.17-.48-.29z"/></svg>
  </a>
  <a class="share-btn" href={fbHref} target="_blank" rel="noopener" aria-label="Share on Facebook">
    <svg viewBox="0 0 24 24"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg>
  </a>
  <a class="share-btn" href={xHref} target="_blank" rel="noopener" aria-label="Share on X">
    <svg viewBox="0 0 24 24"><path d="M18.9 2H22l-7.19 8.21L23.3 22h-6.62l-5.18-6.78L5.5 22H2.38l7.7-8.8L1 2h6.79l4.68 6.2zm-1.16 18.17h1.73L7.35 3.75H5.5z"/></svg>
  </a>
  <button type="button" class="share-btn" data-share-copy aria-label="Copy link">
    <svg viewBox="0 0 24 24"><path d="M3.9 12a3.1 3.1 0 0 1 3.1-3.1h4v-1.8H7a4.9 4.9 0 0 0 0 9.8h4v-1.8H7A3.1 3.1 0 0 1 3.9 12zM8 13h8v-2H8zm9-6.9h-4v1.8h4a3.1 3.1 0 0 1 0 6.2h-4v1.8h4a4.9 4.9 0 0 0 0-9.8z"/></svg>
  </button>
  <span class="share-toast" data-share-toast>Link copied</span>
</div>

<script>
  function wireShare(root: ParentNode) {
    root.querySelectorAll<HTMLElement>('[data-share]').forEach(widget => {
      if (widget.dataset.wired) return;
      widget.dataset.wired = 'true';

      const url = widget.dataset.url || '';
      const title = widget.dataset.title || '';
      const text = widget.dataset.text || '';
      const nativeBtn = widget.querySelector<HTMLButtonElement>('[data-share-native]');
      const copyBtn = widget.querySelector<HTMLButtonElement>('[data-share-copy]');
      const toast = widget.querySelector<HTMLElement>('[data-share-toast]');

      nativeBtn?.addEventListener('click', async () => {
        const nav = navigator as Navigator & { share?: (data: ShareData) => Promise<void> };
        if (nav.share) {
          try { await nav.share({ title, text, url }); return; } catch { /* user cancelled or unsupported — fall through */ }
        }
        copyLink();
      });

      copyBtn?.addEventListener('click', copyLink);

      function copyLink() {
        navigator.clipboard?.writeText(url).then(() => {
          toast?.classList.add('show');
          setTimeout(() => toast?.classList.remove('show'), 2000);
        });
      }
    });
  }

  wireShare(document);
  // Re-wire after Astro view transitions / dynamically injected widgets (lightbox)
  document.addEventListener('astro:page-load', () => wireShare(document));
  (window as any).__wireShare = wireShare;
</script>
